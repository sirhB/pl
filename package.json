{
  "name": "prime-fusion",
  "version": "1.0.0",
  "private": true,
  "description": "QR-enabled ordering platform for Prime Fusion food truck",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
