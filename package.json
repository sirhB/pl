    "date-fns": "^2.30.0",
    "jose": "^5.9.6",
    "lucide-react": "^0.460.0",
    "next": "^14.2.18",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^14.25.0",
    "tailwind-merge": "^2.5.4",
    "twilio": "^5.3.5",
    "zod": "^3.23.8"
